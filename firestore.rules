rules_version = '2';

// ──────────────────────────────────────────────────────────────
//  THE DUEL — security rules (v2: multi-photo + leave days)
//
//  Core guarantee unchanged: both players can READ everything,
//  but neither can WRITE anything that belongs to the other.
//
//  Paste this whole file into:
//  Firebase console → Firestore Database → Rules → Publish
//  (this REPLACES your v1 rules — the app will get permission-denied
//   errors on photos and leave-days until you republish)
// ──────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Player profiles: users/{uid} ----
    match /users/{uid} {
      allow read:  if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // ---- Daily submissions: users/{uid}/days/{YYYY-MM-DD} ----
      match /days/{day} {
        allow read: if signedIn();

        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.at == request.time
                      && request.resource.data.p is number
                      && request.resource.data.p >= 0
                      && request.resource.data.p <= 100;

        // Three legal kinds of update to a day doc:
        //  1. re-submitting the day's numbers -> fresh server timestamp required
        //  2. marking / unmarking a leave day  -> touches only leave + at
        //  3. legacy single-photo flush field  -> kept for compatibility with
        //     any day docs written by the original version of this app
        allow update: if signedIn()
                      && request.auth.uid == uid
                      && (
                           (request.resource.data.at == request.time
                            && request.resource.data.p is number
                            && request.resource.data.p >= 0
                            && request.resource.data.p <= 100)
                           ||
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leave','at'])
                            && request.resource.data.at == request.time)
                           ||
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
                         );

        allow delete: if false;

        // ---- Proof screenshots: users/{uid}/days/{day}/photos/{autoId} ----
        // Each screenshot is its own small document (a single Firestore doc
        // tops out at 1 MiB, which 15 base64 images in one place would blow
        // through). Only the owner can add or remove their own screenshots.
        match /photos/{photoId} {
          allow read: if signedIn();
          allow create: if signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.url is string
                        && request.resource.data.url.size() < 900000
                        && request.resource.data.at == request.time;
          allow update: if false;
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    // ---- Shared settlement record: meta/settle ----
    match /meta/{docId} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // ---- Trash talk: taunts/{autoId} ----
    match /taunts/{id} {
      allow read:   if signedIn();
      allow create: if signedIn()
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 220;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
